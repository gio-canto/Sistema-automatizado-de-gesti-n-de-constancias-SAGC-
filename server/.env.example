# API
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Supabase / PostgreSQL
# Project URL: Supabase Dashboard > Connect
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co

# Clave secreta exclusiva del backend.
# En proyectos nuevos de Supabase utiliza una key sb_secret_...
# NUNCA colocar esta clave en React, Vite, GitHub Pages ni en el repositorio.
SUPABASE_SECRET_KEY=sb_secret_CAMBIAR_ESTA_CLAVE

# Solo para crear el primer administrador de DESARROLLO.
SAGC_BOOTSTRAP_ADMIN_NAME=Administrador SAGC
SAGC_BOOTSTRAP_ADMIN_USER=admin
SAGC_BOOTSTRAP_ADMIN_PASSWORD=CAMBIAR_ESTA_CONTRASENA
